{
    "name": "cuda_flash_attn",
    "image": "pytorch/pytorch:2.3.1-cuda12.1-cudnn8-devel",
    "runArgs": [
        "--gpus",
        "all"
    ],
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-vscode.cpptools",
                "nvidia.nsight-vscode-edition"
            ]
        }
    },
    "remoteUser": "root",
    "settings": {
        "terminal.integrated.shell.linux": "/bin/bash"
    },
    "postCreateCommand": "apt-get update && apt-get install -y git"
}